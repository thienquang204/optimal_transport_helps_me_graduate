# Copy this file to .env and replace the placeholder with a newly generated
# read-only Hugging Face token. Never commit the resulting .env file.
HF_TOKEN=hf_replace_with_a_new_read_only_token

# Defaults for the full pipeline on a 32 GiB GPU. A new output directory keeps
# this 5-epoch scheduler isolated from older 10/90-epoch checkpoints.
# DEVICE must stay CUDA: the runner rejects cpu and mps.
DEVICE=cuda
BATCH_SIZE=256
LEARNING_RATE=0.475
ADAM_LR=0.475
EPOCHS=5
PROBE_EPOCHS=5
# Path *inside* the container. /output is bind-mounted to $OUTPUT_ROOT on the
# host (./runs by default), so everything written here survives the container.
OUTPUT_DIR=/output/imagenet_rn50_b256_e5_lr0475
WORKERS=8
METHOD=both
# The real multi-marginal runner. OT_MARGINALS=3 solves the true 3-marginal
# MMPOT tensor; set 2 for the pairwise proxy. EXPERIMENT_SCRIPT can point at
# /app/matryoshka_mmpot_experiment.py to run the old pairwise-only script.
EXPERIMENT_SCRIPT=/app/matryoshka_real_mmpot_experiment.py
OT_MARGINALS=3
OT_SOLVER_MODE=cyclic
BENCHMARKS=head,linear
# SGD only. Add ,adam to run a second Adam arm after it.
OPTIMIZERS=sgd
MOMENTUM=0.9
ADAM_BETA1=0.9
ADAM_BETA2=0.999
WEIGHT_DECAY=1e-4
