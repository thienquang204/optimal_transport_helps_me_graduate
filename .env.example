# Copy this file to .env and replace the placeholder with a newly generated
# read-only Hugging Face token. Never commit the resulting .env file.
HF_TOKEN=hf_replace_with_a_new_read_only_token

# Defaults for the full pipeline on a 32 GiB GPU. A new output directory keeps
# this 10-epoch scheduler isolated from an older 90-epoch checkpoint.
DEVICE=cuda
BATCH_SIZE=256
LEARNING_RATE=0.475
ADAM_LR=0.475
EPOCHS=10
OUTPUT_DIR=/output/imagenet_rn50_b256_e10_lr0475
WORKERS=8
METHOD=both
BENCHMARKS=head,linear
OPTIMIZERS=sgd,adam
MOMENTUM=0.9
ADAM_BETA1=0.9
ADAM_BETA2=0.999
WEIGHT_DECAY=1e-4
